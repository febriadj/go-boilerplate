# Copy to .env and adjust. `make run` loads .env automatically.

# development | staging | production
APP_ENV=development

HTTP_ADDR=:8080

# Comma-separated origins allowed to call the API from a browser (medpath-client).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# How long to wait for in-flight requests when the server stops.
SHUTDOWN_TIMEOUT=10s

# Serve Swagger UI (/docs/swagger/) and Scalar (/docs). Defaults to true outside production.
API_DOCS_ENABLED=true

# Copy to .env and adjust. `make run` loads .env automatically.

# development | staging | production
APP_ENV=development

HTTP_ADDR=:8080

# Comma-separated origins allowed to call the API from a browser (medpath-client).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# How long to wait for in-flight requests when the server stops.
SHUTDOWN_TIMEOUT=10s

# Serve Swagger UI (/docs/swagger/) and Scalar (/docs). Defaults to true outside production.
API_DOCS_ENABLED=true

# PostgreSQL. The URL holds the password: keep it in .env, never in code or logs.
DATABASE_URL=postgres://medpath:medpath@localhost:5432/medpath?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Production only (compose.prod.yaml builds DATABASE_URL from this; the dev compose uses medpath/medpath).
# Generate one with: openssl rand -hex 32 (hex, because the password is placed in a URL)
# POSTGRES_PASSWORD=
